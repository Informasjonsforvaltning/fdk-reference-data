@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <http://publications.europa.eu/resource/authority/country/> .

ns1:NOR a dct:Location ;
    dct:identifier "NOR" ;
    dct:title "Norway"@en, "Norge"@no .

ns1:DEU a dct:Location ;
    dct:identifier "DEU" ;
    dct:title "Germany"@en, "Tyskland"@no .

ns1:FRA a dct:Location ;
    dct:identifier "FRA" ;
    dct:title "France"@en, "Frankrike"@no .
