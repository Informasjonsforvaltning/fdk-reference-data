	<http://publications.europa.eu/ontology/authority/start.use>	"2015-10-23" .

ns3:DEVELOP	skos:inScheme	ns1:distribution-status ;
	skos:prefLabel	"under utvikling"@no ,
		"under utvikling"@nb ,
		"under development"@en ,
		"under utvikling"@nn ;
	dc:identifier	"DEVELOP" ;
	<http://publications.europa.eu/ontology/authority/start.use>	"2015-10-23" .

ns3:REQUIRED	skos:inScheme	ns1:distribution-status ;
	skos:prefLabel	"required"@en ,
		"p\u00E5krevd"@nb ,
		"p\u00E5kravd"@nn ;
