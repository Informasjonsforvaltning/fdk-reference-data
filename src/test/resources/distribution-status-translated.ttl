	<http://publications.europa.eu/ontology/authority/start.use>	"2026-05-29" .

ns3:ARCHIVE	skos:inScheme	ns1:distribution-status ;
	skos:prefLabel	"historical archive"@en ,
		"arkivert"@nb ,
		"arkivert"@nn ;
	dc:identifier	"ARCHIVE" ;
