PREFIX dc:   <http://purl.org/dc/elements/1.1/>
PREFIX ns1:  <http://publications.europa.eu/resource/authority/currency/>
PREFIX ns2:  <http://publications.europa.eu/resource/authority/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ns2:currency  owl:versionInfo  "20241211-0" .

ns1:USD  <http://publications.europa.eu/ontology/authority/start.use>
                "1990-01-01";
        dc:identifier   "USD";
        skos:inScheme   ns2:currency;
        skos:prefLabel  "US dollar"@en , "Amerikansk dollar"@nb , "Amerikansk dollar"@nn .

ns1:EUR  <http://publications.europa.eu/ontology/authority/start.use>
                "1999-01-01";
        dc:identifier   "EUR";
        skos:inScheme   ns2:currency;
        skos:prefLabel  "Euro"@en , "Euro"@nb , "Euro"@nn .

